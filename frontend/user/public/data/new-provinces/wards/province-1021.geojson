<script>
var rmh=$(window).width();
var cmh=$(window).height();
var chay1,chay2;
var hienthi=true;
//--
var bangtinh, bangxa;
var tinh_ht=-1, xa_ht=-1;
var dltinh=[], dlxa=[], dlxa_ma=[];
var matinh_ht='1';
//--
function khoitao() {
	rmh=$(window).width();
	cmh=$(window).height();
	runDIV1();
	runDIV2();
	if (rmh>cmh) {
		$('#s_giua').css({'display':'flex'});
		$('#s_thongtin').css({'width':'50%'});
		$('#s_bando').css({'width':'50%'});
		$('#s_bando').css({'left':(rmh/2)+'px'});
		$('#s_bando').css({'top':'30px'});
		$('#nhomcongcu1').css({'left':(rmh/2+6)+'px'});
		$('#nhomcongcu1').css({'top':'36px'});
		$('#cuaso1').css({'left':(rmh/2+46)+'px'});
		$('#cuaso1').css({'top':'66px'});
		$('#nhomcongcu2').css({'top':'36px'});
		//$('#s_thongtin').height(cmh-56);
		$('#s_bando').height(cmh-56);
		$('#bangtinh').height(170);
		$('#bangxa').height(cmh-56-170-90-$('#ghichutinh').height());
		//--
		$('#s_tinh').show(500);
		$('#s_xa').show(500);
		hienthi=true;
		$('#bangxa').height(cmh-56-170-90-$('#ghichutinh').height());
		$('#nutdanhmuc').text('DANH MỤC TRA CỨU');
		$('#nutdanhmuc').attr('title','');
		$('#nhom_chuyenhuong').css({'left':(rmh/2+6)+'px'});
		$('#che_lop').css({'left':(rmh/2+46)+'px'});
		$('#che_lop').css({'top':'36px'});
	} else {
		$('#s_top').width(rmh);
		$('#s_bootom').width(rmh);
		$('#s_giua').css({'display':'block'});
		$('#s_giua').width(rmh);
		$('#s_thongtin').width(rmh);
		$('#s_bando').width(rmh);
		$('#s_bando').css({'left':'0px'});
		$('#s_bando').css({'top':'66px'});
		$('#nhomcongcu1').css({'left':'6px'});
		$('#nhomcongcu1').css({'top':'74px'});
		$('#cuaso1').css({'left':'46px'});
		$('#cuaso1').css({'top':'104px'});
		$('#nhomcongcu2').css({'top':'74px'});
		//$('#s_thongtin').height(cmh-56-100);
		$('#s_bando').height(cmh-56);
		$('#bangtinh').height(150);
		$('#bangxa').height(cmh-56-250-90-$('#ghichutinh').height());
		$('#nhom_chuyenhuong').css({'left':'6px'});
		$('#che_lop').css({'left':'46px'});
		$('#che_lop').css({'top':'74px'});
		//--
		$('#nutdanhmuc').attr('title','Nhấn vào đây để Ẩn/Hiện cửa sổ danh mục tra cứu');
		var tendanhmuc='';
		if (rmh<400) tendanhmuc='HỘP TRA CỨU';
		else {
			if (hienthi) {
				tendanhmuc='ẨN HỘP TRA CỨU';
			} else {
				tendanhmuc='HIỆN HỘP TRA CỨU';
			}
		}
		$('#nutdanhmuc').text(tendanhmuc);
	}
}
$(document).ready(function() {
	khoitao();
});
$(window).resize(function() {
	khoitao();
});
//---
function runDIV1() {
	if (chay1) clearInterval(chay1);
	const aDIV=$('#runDIV1');
	const rchay=aDIV.width()-rmh;
	var lui=0;
	var luitien=0;
	if (rchay<=0) {
		aDIV.css("left",(-1)*Math.round(rchay/2)+"px");
		return;
	}
	chay1=setInterval(() => {
		if (luitien==0) {
			lui=lui-1;
			aDIV.css("left",lui+"px");
			if (lui<(-1)*rchay) luitien=1;
		} else {
			lui=lui+1;
			aDIV.css("left",lui+"px");
			if (lui>0) luitien=0;
		}
	},50);
}
function runDIV2() {
	if (chay2) clearInterval(chay2);
	const aDIV=$('#runDIV2');
	const rchay=aDIV.width()-rmh;
	var lui=0;
	var luitien=0;
	if (rchay<=0) {
		aDIV.css("left",(-1)*Math.round(rchay/2)+"px");
		return;
	}
	chay2=setInterval(() => {
		if (luitien==0) {
			lui=lui-1;
			aDIV.css("left",lui+"px");
			if (lui<(-1)*rchay) luitien=1;
		} else {
			lui=lui+1;
			aDIV.css("left",lui+"px");
			if (lui>0) luitien=0;
		}
	},50);
}
//--
$('#nutdanhmuc').click(function() {
	if (cmh>rmh) {
		var tendanhmuc='';
		if (hienthi) {
			$('#s_tinh').hide(500);
			$('#s_xa').hide(500);
			//$('#s_thongtin').height(46);
			hienthi=false;
			if (rmh<400) tendanhmuc='HỘP TRA CỨU';
			else tendanhmuc='HIỆN HỘP TRA CỨU';
			$('#nutdanhmuc').text(tendanhmuc);
		} else {
			$('#s_tinh').show(500);
			$('#s_xa').show(500);
			//$('#s_thongtin').height(cmh-56-100);
			hienthi=true;
			bangtinh.scrollToRow(tinh_ht);
			if (rmh<400) tendanhmuc='HỘP TRA CỨU';
			else tendanhmuc='ẨN HỘP TRA CỨU';
			$('#nutdanhmuc').text(tendanhmuc);
		}
	}
});
function an_menu_danhmuc() {
	if (cmh>rmh) {
		$('#s_tinh').hide(500);
		$('#s_xa').hide(500);
		//$('#s_thongtin').height(46);
		hienthi=false;
		var tendanhmuc='';
		if (rmh<400) tendanhmuc='HỘP TRA CỨU';
		else tendanhmuc='HIỆN HỘP TRA CỨU';
		$('#nutdanhmuc').text(tendanhmuc);
	}
}
$('#s_bando').click(function() {
	an_menu_danhmuc();
});
$('#nutchiase').hide();
$('#nutchiase').click(function() {
	const u=(window.location.href).split("amap?map=");
	const t=u[0]+"amap?map="+tinh_ht+"xyztinh="+matinh_ht+"xyzxa="+xa_ht+"xatinhxyz";
	$('#link_chiase').val(t);
	document.getElementById('id01').style.display='block';
	$('#link_chiase').focus().select();
	document.execCommand('copy');
});
function copy_link() {
	try {  
		var successful = document.execCommand('copy');
		document.getElementById('id01').style.display='none';
	} catch(err) {  
		console.error('Unable to copy'); 
	}
}
</script>

<script type="text/javascript" src="s4.3.js"></script>

<script>
get123();
//--
const opacityInput = document.getElementById('opacity-input');
const opacityOutput = document.getElementById('opacity-output');
function dat_opacity() {
  const opacity = parseFloat(opacityInput.value);
  lopbando.setOpacity(opacity);
  opacityOutput.innerText = opacity.toFixed(2);
}
opacityInput.addEventListener('input', dat_opacity);
//--
function cotinh() {
	dat_opacity();
	//--
	const o1={id:"0"};
	bangtinh=null;
	goiSV('pcotinh','post','text',o1,function(kq) {
		if (kq!='') {
			var dat=$.parseJSON(kq.trim());
			dltinh=dat;
			var o=[];
			var cs=0;
			var t1='';
			for (var i=0; i<dat.length; ++i) {
				cs=cs+1;
				if (dat[i].truocsapnhap=='không sáp nhập') {
					t1=dat[i].tentinh+' (Giữ nguyên, '+dat[i].truocsapnhap+')';
				} else {
					t1=dat[i].truocsapnhap;
				}
				o[i]={id:i,stt:cs,mahc:dat[i].mahc,ten:dat[i].tentinh,truocsn:t1};
				if (i>=dat.length-1) {
					bangtinh=new Tabulator("#bangtinh", {
 						data:o,
 						layout:"fitColumns",
 						selectableRows:true,
 						columns:[
 							{title:"TT", field:"stt", width:30, hozAlign:"center"},
				 			{title:"Tỉnh/TP mới (34)", field:"ten",width:160, headerFilter:"input", headerFilterPlaceholder:"nhập tên cần tìm"},
				 			{title:"Tỉnh/TP trước sáp nhập (63)", field:"truocsn", formatter:"textarea", headerFilter:"input", headerFilterPlaceholder:"nhập từ cần tìm"},
 						],
 						reactiveData:true,
					});
					break;
				}
			}
			
			
			function xyz1() {
				const u=(window.location.href).split('?map=');
				if (u.length==2) {
					const u2=u[1].split("xyztinh=");
					if (u2.length==2) {
						chontinh(u2[1].split("xyzxa=")[0],0,0);
					} else {
						chontinh('1',0,0);
					}
				} else {
					chontinh('1',0,0);
				}
			}
			
			bangtinh.on("dataLoaded", function() {
				xyz1();
			});
			
			
			bangtinh.on("rowClick", function(e, row) {
				const cs=row.getIndex();
				const elem=row.getData(); //elem.id, elem.ten, ...
				chontinh(elem.mahc,3,0);
			});
			
		}
	});
}
function chon_dong_tinh(mahc) {
	if (tinh_ht>-1) bangtinh.deselectRow();
	var cs='0';
	for (var i=0; i<dltinh.length; ++i) {
		if (dltinh[i].mahc==mahc) {
			cs=i; break;
		}
	}
	bangtinh.selectRow(cs);
	bangtinh.scrollToRow(cs);
	tinh_ht=cs;
	matinh_ht=mahc;
	return cs;
}
function chontinh(mahc,key,maxa) {
	const ma=chon_dong_tinh(mahc);
	xa_ht=0;
	$('#nutchiase').show();
	var k='', k1='';
	if (dltinh[ma].truocsapnhap=='không sáp nhập') {
		k='<b>'+dltinh[ma].tentinh+'</b>: diện tích '+dltinh[ma].dientichkm2+' km<sup>2</sup>, dân số '+dltinh[ma].dansonguoi+' người. Cấp tỉnh: '+dltinh[ma].truocsapnhap+'. <b>. Cấp xã</b> sáp nhập còn '+dltinh[ma].con+'. <b>Chi tiết</b>:';
		k1=dltinh[ma].tentinh+'\nDiện tích '+dltinh[ma].dientichkm2+' km2, dân số '+dltinh[ma].dansonguoi+' người.\nCấp tỉnh: '+dltinh[ma].truocsapnhap+'.\nCấp xã sáp nhập còn '+dltinh[ma].con;
	} else {
		k='<b>'+dltinh[ma].tentinh+'</b> (mới): diện tích '+dltinh[ma].dientichkm2+' km<sup>2</sup>, dân số '+dltinh[ma].dansonguoi+' người. Sáp nhập từ: '+dltinh[ma].truocsapnhap+' (cũ). Trung tâm hành chính mới đặt ở: '+dltinh[ma].trungtamhc+'. <b>Cấp xã</b> sáp nhập còn '+dltinh[ma].con+'. <b>Chi tiết</b>:';
		k1=dltinh[ma].tentinh+' (mới)\nDiện tích '+dltinh[ma].dientichkm2+' km2, dân số '+dltinh[ma].dansonguoi+' người.\nSáp nhập từ: '+dltinh[ma].truocsapnhap+' (cũ).\nTrung tâm hành chính mới đặt ở: '+dltinh[ma].trungtamhc+'.\nCấp xã sáp nhập còn '+dltinh[ma].con;
	}
	datHTML(k,$('#ghichutinh')).then(function(kq) {
		khoitao();
	});
	coxa(mahc,key,maxa);
	//--
	if (key==0 || key==3) den_diem_bando(k1,dltinh[ma].kinhdo,dltinh[ma].vido,0);
}
function coxa(mahc,key,maxa) {
	const o1={id:mahc};
	bangxa=null;
	goiSV('ptracuu','post','text',o1,function(kq) {
		if (kq!='') {
			var dat=$.parseJSON(kq.trim());
			dlxa=dat;
			var o=[];
			var cs=0;
			var ten='';
			var t1='';			
			for (var i=0; i<dat.length; ++i) {
				dlxa_ma[i]=dat[i].maxa;
				cs=cs+1;
				ten=dat[i].tenhc+' ('+dat[i].loai+')';
				if (dat[i].truocsapnhap=='Không sáp nhập') {
					t1=dat[i].loai+' '+dat[i].tenhc+' (Giữ nguyên, '+dat[i].truocsapnhap+')';
				} else {
					t1=dat[i].truocsapnhap;
				}
				o[i]={id:i,stt:cs,ten:ten,truocsn:t1};
				if (i>=dat.length-1) {
					bangxa=new Tabulator("#bangxa", {
 						data:o,
 						layout:"fitColumns",
 						selectableRows:true,
 						columns:[
 							{title:"TT", field:"stt", width:30, hozAlign:"center"},
				 			{title:"Phường/Xã mới", field:"ten",width:160, headerFilter:"input", headerFilterPlaceholder:"nhập tên cần tìm"},
				 			{title:"Phường/Xã trước sáp nhập", field:"truocsn", formatter:"textarea", headerFilter:"input", headerFilterPlaceholder:"nhập từ cần tìm"},
 						],
 						reactiveData:true,
					});
					break;
				}
			}
			
			
			function xyz2() {
				if (key==2) {
					chon_dong_xa(maxa); return;
				} else {
					if (key==3 || key==1) {
						return;
					} else {
						const u=(window.location.href).split('xyzxa=');
						if (u.length==2) {
							const u2=u[1].split("xatinhxyz");
							if (u2.length==2 && u2[0]!='0') {
								chonxa(Number(u2[0]));
							}
						}
					}
				}
			}
			
			
			bangxa.on("dataLoaded", function() {
				setTimeout(xyz2,300);
			});
			
			
			bangxa.on("rowClick", function(e, row) {
				const cs=row.getIndex();
				const elem=row.getData(); //elem.id, elem.ten, ...
				chonxa(elem.id);
			});
		}
	});
}
function chon_dong_xa(maxa) {
	var cs='0';
	for (var i=0; i<dlxa_ma.length; ++i) {
		if (dlxa_ma[i]==maxa) {
			cs=i; break;
		}
	}
	if (xa_ht>-1) bangxa.deselectRow();
	bangxa.selectRow(cs);
	xa_ht=cs;
	//--
	bangxa.scrollToRow(Number(cs), "nearest", false);
}
function chonxa(cs) {
	if (xa_ht>-1) bangxa.deselectRow();
	bangxa.selectRow(cs);
	bangtinh.scrollToRow(tinh_ht);
	xa_ht=cs;
	bangxa.scrollToRow(Number(cs), "top", false);
	//--
	const ma=cs;
	/*
	var k='';
	var t=dlxa[ma].truocsapnhap;
	var pos=t.indexOf(', ');
	var v1=0;
	var k='';
	var dt='',ds='';
	while (pos>-1) {
		if ((pos-v1)>30) {
			k=k+t.substring(v1,pos+1)+'\n';
			v1=pos+1;
			pos=t.indexOf(', ',v1);
		} else {
			pos=t.indexOf(', ',pos+1);
		}
	}
	k=k+t.substr(v1);
	if (dlxa[ma].dientichkm2=='0') dt="đang cập nhật";
	else dt=String(dlxa[ma].dientichkm2).replace('.',',');
	if (dlxa[ma].dansonguoi=='đang cập nhật') ds=dlxa[ma].dansonguoi;
	else ds=tachHangNghin(dlxa[ma].dansonguoi,'.');
	k=k+'.\nDiện tích: '+dt+' (km2). Dân số: '+ds+' (người)';
	k=k+'.\nTrụ sở hành chính (mới): '+dlxa[ma].trungtamhc+'.';
	var k1='';
	const ten=dlxa[ma].loai+' '+dlxa[ma].tenhc;
	if (dlxa[ma].truocsapnhap=='Không sáp nhập') k1=ten+' của '+dltinh[tinh_ht].tentinh+'.\n'+dlxa[ma].truocsapnhap;
	else k1=ten+' (mới) của '+dltinh[tinh_ht].tentinh+'.\nSáp nhập từ: '+k;
	*/
	an_menu_danhmuc();
	den_diem_bando('',Number(dlxa[ma].kinhdo),Number(dlxa[ma].vido),1);
}
</script>

