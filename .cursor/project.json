{
  "name": "mypak-webapi",
  "description": "Backend API for mypak-webapi using .NET 9 Clean Architecture.",
  "owner": "Khuong",

  "context": {
    "primaryFocus": "Backend API (.NET 9, Clean Architecture)",
    "principles": [
      "SOLID",
      "Clean Architecture",
      "CQRS + MediatR",
      "FluentValidation",
      "English-only code"
    ]
  },

  "structure": {
    "backend": {
      "path": "src/",
      "defaultProject": "mypak-webapi",
      "projects": ["Domain", "Application", "Infrastructure", "Web"],
      "rules": ["BackendRules.md"],
      "limitScope": true
    }
  },

  "conventions": {
    "naming": {
      "classes": "PascalCase",
      "interfaces": "IName",
      "files": "Match class name"
    }
  },

  "team": {
    "lead": "Khuong",
    "assistant": "Cursor AI (Senior Architect mode)"
  }
}
